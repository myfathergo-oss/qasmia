# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://qasmia_user:CHANGE_ME@localhost:5432/qasmia_db

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_64_CHARS
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── First Admin Setup (used only during first run) ────────────
SETUP_ADMIN_USERNAME=ustad0001
SETUP_ADMIN_TEMP_PASSWORD=CHANGE_THIS_BEFORE_FIRST_RUN

# ── File Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
